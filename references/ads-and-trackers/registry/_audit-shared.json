  "hints": [
    { "id": "generic-events", "tool": "find-trackers", "flag": "generic", "scope": "app_code", "match": "method",
      "title": "Generic — Event Tracking Methods",
      "tokens": ["trackEvent", "logEvent", "recordEvent", "pushEvent", "logCustomEvent"] },
    { "id": "generic-identity", "tool": "find-trackers", "flag": "generic", "scope": "app_code", "match": "method",
      "title": "Generic — User Identification",
      "tokens": ["setUserId", "setCustomerUserId", "identify", "setDistinctId", "onUserLogin", "changeUser"] },
    { "id": "generic-toggle", "tool": "find-trackers", "flag": "generic", "scope": "app_code", "match": "method",
      "title": "Generic — Analytics Collection Toggle",
      "tokens": ["setAnalyticsCollectionEnabled", "setOptOut", "setDataCollectionEnabled", "setSendingEnabled", "optOut", "gdprForgetMe"] },
    { "id": "tracker-endpoint-infra", "tool": "find-trackers", "flag": "endpoints", "scope": "app_code", "match": "literal",
      "title": "Known Tracker Endpoints",
      "tokens": ["firebaselogging"] },
    { "id": "tracker-perms", "tool": "find-trackers", "flag": "manifest", "scope": "manifest", "match": "exact",
      "title": "AndroidManifest — Tracker Permissions",
      "tokens": ["com.google.android.gms.permission.AD_ID", "android.permission.ACCESS_ADSERVICES_AD_ID", "android.permission.ACCESS_ADSERVICES_ATTRIBUTION", "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.GET_ACCOUNTS"] },
    { "id": "tracker-meta-prefix", "tool": "find-trackers", "flag": "manifest", "scope": "manifest", "match": "literal",
      "title": "AndroidManifest — Tracker Meta-data",
      "tokens": ["ADJUST_", "APPSFLYER_", "MIXPANEL_", "AMPLITUDE_", "SEGMENT_", "BRAZE_", "CLEVERTAP_", "FLURRY_"] },
    { "id": "tracker-manifest-infra", "tool": "find-trackers", "flag": "manifest", "scope": "manifest", "match": "literal",
      "title": "AndroidManifest — Tracker Services & Receivers",
      "tokens": ["com.google.firebase.iid."] },
    { "id": "ad-unit-ids", "tool": "find-ads", "flag": "formats", "scope": "app_code", "match": "word",
      "title": "Cross-SDK — Ad Unit / Placement IDs",
      "tokens": ["adUnitId", "placementId"] },
    { "id": "ad-unit-setters", "tool": "find-ads", "flag": "formats", "scope": "app_code", "match": "method",
      "title": "Cross-SDK — Ad Unit / Placement IDs",
      "tokens": ["setAdUnitId", "setPlacementId"] },
    { "id": "ad-unit-consts", "tool": "find-ads", "flag": "formats", "scope": "app_code", "match": "literal",
      "title": "Cross-SDK — Ad Unit / Placement IDs",
      "tokens": ["PLACEMENT_ID", "AD_UNIT_ID", "BANNER_ID", "INTERSTITIAL_ID", "REWARDED_ID"] },
    { "id": "mediation-classes", "tool": "find-ads", "flag": "mediation", "scope": "app_code", "match": "literal",
      "title": "Mediation — Adapter Classes",
      "tokens": ["MediationAdapter", "MediationBannerAdapter", "MediationInterstitialAdapter", "MediationRewardedAd", "IronSourceAdapter", "ISBannerAdapter", "ISInterstitialAdapter", "ISRewardedVideoAdapter", "MediationAdapterBase", "MaxAdapter", "MaxMediatedNetworkInfo"] },
    { "id": "waterfall", "tool": "find-ads", "flag": "mediation", "scope": "app_code", "match": "literal",
      "title": "Mediation — Waterfall & Bidding Configuration",
      "tokens": ["waterfall", "setWaterfall", "headerBidding", "realTimeBidding", "mediationConfig", "auctionResponse", "adNetworkId"] },
    { "id": "tcf", "tool": "find-ads", "flag": "consent", "scope": "app_code", "match": "literal",
      "title": "Consent — IAB TCF v2",
      "tokens": ["IABTCF_", "IABGPP_", "IABUSPrivacy_String", "gdprApplies", "tcfPolicyVersion", "TCString", "tcString", "GDPR_APPLIES", "GDPR_CONSENT"] },
    { "id": "coppa", "tool": "find-ads", "flag": "consent", "scope": "app_code", "match": "word",
      "title": "Consent — COPPA / Child-Directed",
      "tokens": ["tagForChildDirectedTreatment", "maxAdContentRating", "setTagForUnderAgeOfConsent"] },
    { "id": "coppa-consts", "tool": "find-ads", "flag": "consent", "scope": "app_code", "match": "literal",
      "title": "Consent — COPPA / Child-Directed",
      "tokens": ["COPPA", "TAG_FOR_CHILD_DIRECTED", "TAG_FOR_UNDER_AGE_OF_CONSENT"] },
    { "id": "optout-unmapped", "tool": "find-ads", "flag": "consent", "scope": "app_code", "match": "method",
