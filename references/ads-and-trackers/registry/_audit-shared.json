    { "id": "ad-meta", "tool": "find-ads", "flag": "manifest", "scope": "manifest", "match": "exact",
      "title": "AndroidManifest — Ad Meta-data",
      "tokens": ["com.facebook.sdk.ApplicationId", "unity.ads.gameId"] },
    { "id": "ad-activity-generic", "tool": "find-ads", "flag": "manifest", "scope": "manifest", "match": "literal",
      "title": "AndroidManifest — Ad Activities & Services",
